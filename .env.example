# Las variables de la app (`pnpm env:check` dice qué falta, sin imprimir valores). Copia este archivo a `.env.local` y llénalo.
# semilla-a-repo ajusta los puertos al bloque del proyecto (PILOTO_BLOQUE de piloto.config; scripts/lib/stack-local.mjs).
# Las de Calesa (semilla §4) son obligatorias sólo en Vercel (VERCEL_ENV=preview|production, lo pone Vercel); en local, sin valor,
# no pasa nada. Los ejemplos de abajo nunca son claves reales: las reales van sólo en Vercel.

# Supabase (local: `pnpm exec supabase start` te imprime estos valores)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sólo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# El sitio (todos los entornos; obligatoria en Vercel). En local, sin valor: `urlDelSitio()` usa el origen del pedido.
# NEXT_PUBLIC_SITIO_URL=https://calesa.app

# Correo de la app (src/shared/lib/email): ninguno | mailpit. Sin proveedor no se manda nada.
EMAIL_PROVEEDOR=ninguno
EMAIL_REMITENTE=hola@getcalesa.com
EMAIL_REMITENTE_NOMBRE=Calesa
# Mailpit, el correo local de Supabase ([local_smtp] de supabase/config.toml)
MAILPIT_URL=http://127.0.0.1:55324
# A dónde van los avisos al equipo y las consultas de privacidad (F4). Sin valor, estos mismos.
EMAIL_AVISOS=equipo@getcalesa.com
EMAIL_PRIVACIDAD=privacidad@getcalesa.com

# Resend (vista previa y producción). Sólo servidor.
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Cloudflare Turnstile (vista previa y producción). Éstas son las claves de prueba públicas de Cloudflare (siempre pasan).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Secretos del servidor (vista previa y producción): 32 caracteres o más, al azar (`openssl rand -hex 32`).
# CRON_SECRET: Vercel Cron lo manda como `Authorization: Bearer`. TOKEN_FIRMA_SECRETO: firma los tokens de solicitud.
CRON_SECRET=cambia-esto-por-32-caracteres-al-azar
TOKEN_FIRMA_SECRETO=cambia-esto-por-32-caracteres-al-azar
IP_SAL_SECRETO=cambia-esto-por-32-caracteres-al-azar

# La cuenta del admin (vista previa y producción). El correo real del admin (X14) se carga sólo en Vercel.
ADMIN_EMAIL=admin@ejemplo.com
# Producción: «si» sólo cuando el abogado aprobó los textos legales (lo exige el build de producción, paso P10).
LEGAL_APROBADO=no
